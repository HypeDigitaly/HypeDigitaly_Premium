{
  "website": {
    "base_url": "https://stredoceskykraj.cz/",
    "sitemap_url": "https://stredoceskykraj.cz/web/urad/mapa-stranek",
    "xml_sitemap_url": "https://stredoceskykraj.cz/sitemap.xml",
    "blacklisted_urls": []
  },
  "api_keys": {
    "jina_ai": "your_jina_api_key_here",
    "firecrawl": "your_firecrawl_api_key_here",
    "openai": "your_openai_api_key_here"
  },
  "content_providers": {
    "jina": {
      "name": "jina",
      "remove_selectors": ""
    },
    "firecrawl": {
      "name": "firecrawl"
    },
    "provider_sequence": "jina,firecrawl"
  },
  "vector_store": {
    "id": null,
    "enable_deduplication": true,
    "chunking_strategy": "auto",
    "max_chunk_size": 800,
    "chunk_overlap": 400
  },
  "http_settings": {
    "request_timeout": 150,
    "retry_codes": [500, 502, 503, 504, 524],
    "retry_count": 3,
    "backoff_factor": 0.3
  },
  "processing": {
    "check_last_modified": true,
    "max_filename_length": 200,
    "request_delay": 1
  },
  "output": {
    "directory": "files",
    "log_directory": "logs",
    "last_run_file": "last_run_time.txt"
  },
  "script_info": {
    "name": "scrape_sitemap_universal",
    "version": "1.0.0"
  }
} 