  "api_keys": {
    "jina_ai": "env:JINA_AI_API_KEY",
    "firecrawl": "env:FIRECRAWL_API_KEY",
    "openai": "env:OPENAI_API_KEY_USTI_OBVOD_SEVERNITERASA",
    "openrouter": "env:OPENROUTER_API_KEY_USTI_OBVOD_SEVERNITERASA"
  },
  "openrouter": {
    "max_tokens": 64000,
    "target_language": "Czech",
    "models": [
      "google/gemini-2.5-flash-preview-09-2025",
      "openai/gpt-4.1-mini" 
    ],
    "temperature": 0.1,
    "top_p": 0.9,
    "fallback_enabled": true,
    "timeout_seconds": 120
  },
  "content_providers": {
    "jina": {
      "name": "jina",
      "remove_selectors": "header, footer, aside",
      "target_selectors": "main, #main, .main"
    },
    "firecrawl": {
      "name": "firecrawl"
    },
    "provider_sequence": "jina,firecrawl"
  },
  "vector_store": {
    "id": "vs_68d053ffced48191adcbb1084b80dc77",
    "enable_deduplication": true,
    "chunking_strategy": "static",
    "max_chunk_size": 4096,
    "chunk_overlap": 0,
    "content_token_offset": 500,
    "content_ratio": 0.5
  },
  "http_settings": {
    "request_timeout": 150,
    "retry_codes": [500, 502, 503, 504, 524],
    "retry_count": 3,
    "backoff_factor": 0.3
  },
  "processing": {
    "check_last_modified": true,
    "max_filename_length": 200,
    "RSSDateThreshold": "01-01-2025"
  },
  "script_info": {
    "name": "scrape_sitemap_GPT_v2",
    "version": "1.0.0"
  }
