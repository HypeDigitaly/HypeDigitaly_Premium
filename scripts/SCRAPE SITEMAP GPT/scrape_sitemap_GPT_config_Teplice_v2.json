  "openrouter": {
    "max_tokens": 64000,
    "target_language": "Czech",
    "models": [
      "google/gemini-2.5-flash",
      "anthropic/claude-sonnet-4"
    ],
    "temperature": 0.1,
    "top_p": 0.9,
