{
  "website": {
    "base_url": "https://example.com/",
    "sitemap_url": "https://example.com/sitemap-page",
    "xml_sitemap_url": "https://example.com/sitemap.xml",
    "blacklisted_urls": [
      "https://example.com/private-page",
      "https://example.com/admin"
    ],
    "rss_feeds": [
      "https://example.com/rss",
      "https://example.com/feed.xml",
      "https://example.com/news.rss"
    ],
    "recursive_urls": [
      {
        "url": "https://example.com/documents/",
        "recursive_level": 2
      },
      "https://example.com/news/"
    ],
    "test_urls": []
  },
  "api_keys": {
    "jina_ai": "your_jina_api_key_here",
    "firecrawl": "your_firecrawl_api_key_here",
    "openai": "your_openai_api_key_here",
    "openrouter": "your_openrouter_api_key_here"
  },
  "openrouter": {
    "max_tokens": 64000,
    "target_language": "Czech",
    "models": [
      "google/gemini-2.5-flash-preview-09-2025",
      "anthropic/claude-sonnet-4"
    ],
    "temperature": 0.1,
    "top_p": 0.9,
    "fallback_enabled": true,
    "timeout_seconds": 120
  },
  "content_providers": {
    "jina": {
      "name": "jina",
      "remove_selectors": "#header, .sidebar, .ads, footer, .comments",
      "target_selectors": ""
    },
    "firecrawl": {
      "name": "firecrawl"
    },
    "provider_sequence": "jina,firecrawl"
  },
  "vector_store": {
    "id": null,
    "enable_deduplication": true,
    "chunking_strategy": "static",
    "max_chunk_size": 1200,
    "chunk_overlap": 200,
    "content_token_offset": 0,
    "content_ratio": 0.5
  },
  "http_settings": {
    "request_timeout": 120,
    "retry_codes": [500, 502, 503, 504, 524],
    "retry_count": 2,
    "backoff_factor": 0.5
  },
  "processing": {
    "check_last_modified": true,
    "max_filename_length": 150,
    "RSSDateThreshold": "01-01-2025"
  },
  "script_info": {
    "name": "example_scraper",
    "version": "1.0.0"
  }
}